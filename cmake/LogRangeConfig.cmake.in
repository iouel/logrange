@PACKAGE_INIT@

# LogRange is header-only: no library to find, no dependencies to chase.
# The imported target LogRange::logrange carries the include directory, the
# C++17 requirement, and the floating-point flag the error contract depends
# on (-ffp-contract=off / precise). See the note in LogRangeTargets.cmake's
# INTERFACE_COMPILE_OPTIONS and the header's precision floor section.
include("${CMAKE_CURRENT_LIST_DIR}/LogRangeTargets.cmake")

check_required_components(LogRange)
